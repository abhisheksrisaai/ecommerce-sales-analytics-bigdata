<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  BCSE402L - Big Data Analytics (TH)
  DA-2 artefact: YARN configuration.

  yarn.nodemanager.aux-services is the important one: it registers the
  MapReduce shuffle handler inside each NodeManager, which is how reducers
  pull their map output over HTTP during the shuffle phase.
-->
<configuration>

  <!-- Registers the shuffle service. Without mapreduce_shuffle, jobs fail at
       the reduce stage because reducers cannot fetch map output. -->
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services.mapreduce_shuffle.class</name>
    <value>org.apache.hadoop.mapred.ShuffleHandler</value>
  </property>

  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>localhost</value>
  </property>

  <property>
    <name>yarn.resourcemanager.scheduler.address</name>
    <value>localhost:8030</value>
  </property>
  <property>
    <name>yarn.resourcemanager.resource-tracker.address</name>
    <value>localhost:8031</value>
  </property>
  <property>
    <name>yarn.resourcemanager.address</name>
    <value>localhost:8032</value>
  </property>
  <property>
    <name>yarn.resourcemanager.webapp.address</name>
    <value>localhost:8088</value>
  </property>

  <!-- Memory offered by the single NodeManager, kept within the laptop's
       budget so the cluster does not swap. -->
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>4096</value>
  </property>
  <property>
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>512</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>2048</value>
  </property>

  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>4</value>
  </property>

  <!-- Environment forwarded from the client to the container, so the task JVM
       inherits JAVA_HOME and finds the JDK. -->
  <property>
    <name>yarn.nodemanager.env-whitelist</name>
    <value>JAVA_HOME,HADOOP_COMMON_HOME,HADOOP_HDFS_HOME,HADOOP_CONF_DIR,CLASSPATH_PREPEND_DISTCACHE,HADOOP_YARN_HOME,HADOOP_MAPRED_HOME,PATH,LANG,TZ</value>
  </property>

  <!-- Allow the container to use the physical memory limit of the host. -->
  <property>
    <name>yarn.nodemanager.pmem-check-enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
  </property>

  <property>
    <name>yarn.nodemanager.log-dirs</name>
    <value>/Users/abhishek/bd-hadoop-data/yarn/container-logs</value>
  </property>
  <property>
    <name>yarn.nodemanager.local-dirs</name>
    <value>/Users/abhishek/bd-hadoop-data/yarn/local</value>
  </property>

</configuration>
